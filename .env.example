# ------------------------------------------------------------------
# Social Media Agent — environment template
# Copy to .env and fill in real values. NEVER commit .env.
# ------------------------------------------------------------------

# Core
APP_NAME=Social Media AI Agent
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/social_agent
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Queue / scheduling
REDIS_URL=redis://localhost:6379/0
DEFAULT_TIMEZONE=Asia/Kolkata

# App auth
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Encrypts stored social tokens at rest. Fernet key (base64, 32 bytes).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ------------------------------------------------------------------
# LinkedIn OAuth (OAuth 2.0 Authorization Code)
# App: https://www.linkedin.com/developers/apps
# Scopes: openid email profile w_member_social
# ------------------------------------------------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/auth/linkedin/callback
LINKEDIN_VERSION=202603

# ------------------------------------------------------------------
# Facebook OAuth (Meta Login for Business)
# App: https://developers.facebook.com/apps
# Scopes: email, pages_show_list, pages_read_engagement, pages_manage_posts
# ------------------------------------------------------------------
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/v1/auth/facebook/callback

# ------------------------------------------------------------------
# Instagram OAuth (Meta Business account; may share the Facebook app)
# Scopes: instagram_basic, instagram_content_publish, pages_show_list, business_management
# ------------------------------------------------------------------
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/v1/auth/instagram/callback

# ------------------------------------------------------------------
# X (Twitter) OAuth 2.0 Authorization Code with PKCE
# App: https://developer.x.com -> project/app -> "Keys and tokens"
#   X_CLIENT_ID       -> "OAuth 2.0 Client ID"
#   X_CLIENT_SECRET    -> "OAuth 2.0 Client Secret" (optional for public
#                         clients; used to authenticate token requests)
# Required scopes (set in the app's "User authentication settings"):
#   tweet.read users.read tweet.write offline.access
# Callback URL in the X Developer Portal must EXACTLY match X_REDIRECT_URI
#   e.g. https://your-backend.example.com/api/v1/auth/x/callback
# ------------------------------------------------------------------
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8000/api/v1/auth/x/callback
# Default max X post length (280 = standard; 25000 = Premium accounts).
# When X rejects a post for length, the real limit for the connected
# account is detected from X's error and stored per account automatically.
X_POST_MAX_LENGTH=280